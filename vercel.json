{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/proximamente",
      "destination": "/universo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://astrea-api-production.up.railway.app/api/v1/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://astrea-api-production.up.railway.app/api/v1/blog/:path*"
    },
    {
      "source": "/r/:token",
      "destination": "https://astrea-informe-react.vercel.app/r/:token"
    },
    {
      "source": "/admin",
      "destination": "https://astrea-informe-react.vercel.app/admin"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://astrea-informe-react.vercel.app/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/universo-assets/contacto/(.*)\\.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Carla-Valderrama.vcf\""
        }
      ]
    }
  ]
}
